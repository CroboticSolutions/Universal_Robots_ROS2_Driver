<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- Disable collisions for Robotiq 2F-85 on UR tool0.
       Matches ur_simulation_gz simplified parallel gripper (two knuckle links only). -->
  <xacro:macro name="ur_robotiq_disable_collisions" params="">
    <disable_collisions link1="tool0" link2="robotiq_coupler_link" reason="Adjacent" />
    <disable_collisions link1="tool0" link2="ur_to_robotiq_link" reason="Adjacent" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_coupler_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="ur_to_robotiq_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="wrist_2_link" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="wrist_1_link" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="forearm_link" link2="robotiq_85_base_link" reason="Never" />

    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_base_link" reason="Adjacent" />
    <disable_collisions link1="robotiq_coupler_link" link2="ur_to_robotiq_link" reason="Adjacent" />
    <disable_collisions link1="robotiq_coupler_link" link2="robotiq_85_base_link" reason="Adjacent" />

    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Never" />

    <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
  </xacro:macro>
</robot>
